# Check that the directories exist
proc checkRequiredFiles { rtl_dir } {
  set status true
  foreach idir [list $rtl_dir "$rtl_dir/cw305" "$rtl_dir/vitis_hls_export"] {
    if { ![file isdirectory $idir] } {
      puts " Could not find source directory $idir "
      set status false
    }
  }
  foreach ifile [list "$rtl_dir/cw305/cw305.xdc" "$rtl_dir/uov_wrapper_tb.sv"] {
    if { ![file isfile $ifile] } {
      puts " Could not find required file $ifile "
      set status false
    }
  }
  return $status
}
