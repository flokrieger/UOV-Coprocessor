set_property -name "statistics.ff" -value "1" -objects $obj
set_property -name "statistics.gt" -value "1" -objects $obj
set_property -name "statistics.io" -value "1" -objects $obj
set_property -name "statistics.lut" -value "1" -objects $obj
set_property -name "statistics.lutram" -value "1" -objects $obj
set_property -name "statistics.mmcm" -value "1" -objects $obj
set_property -name "statistics.pcie" -value "1" -objects $obj
set_property -name "statistics.pll" -value "1" -objects $obj
set_property -name "statistics.uram" -value "1" -objects $obj
set_property -name "view.orientation" -value "Horizontal" -objects $obj
set_property -name "view.type" -value "Graph" -objects $obj

# Create 'utilization_2' gadget (if not found)
if {[string equal [get_dashboard_gadgets  [ list "utilization_2" ] ] ""]} {
create_dashboard_gadget -name {utilization_2} -type utilization
}
set obj [get_dashboard_gadgets [ list "utilization_2" ] ]
set_property -name "active_reports" -value "" -objects $obj
set_property -name "active_reports_invalid" -value "" -objects $obj
set_property -name "active_run" -value "0" -objects $obj
set_property -name "hide_unused_data" -value "1" -objects $obj
set_property -name "incl_new_reports" -value "0" -objects $obj
set_property -name "reports" -value "impl_1#impl_1_place_report_utilization_0" -objects $obj
set_property -name "run.step" -value "place_design" -objects $obj
set_property -name "run.type" -value "implementation" -objects $obj
set_property -name "statistics.bram" -value "1" -objects $obj
set_property -name "statistics.bufg" -value "1" -objects $obj
set_property -name "statistics.dsp" -value "1" -objects $obj
set_property -name "statistics.ff" -value "1" -objects $obj
set_property -name "statistics.gt" -value "1" -objects $obj
set_property -name "statistics.io" -value "1" -objects $obj
set_property -name "statistics.lut" -value "1" -objects $obj
set_property -name "statistics.lutram" -value "1" -objects $obj
set_property -name "statistics.mmcm" -value "1" -objects $obj
set_property -name "statistics.pcie" -value "1" -objects $obj
set_property -name "statistics.pll" -value "1" -objects $obj
set_property -name "statistics.uram" -value "1" -objects $obj
set_property -name "view.orientation" -value "Horizontal" -objects $obj
set_property -name "view.type" -value "Graph" -objects $obj

move_dashboard_gadget -name {utilization_1} -row 0 -col 0
move_dashboard_gadget -name {power_1} -row 1 -col 0
move_dashboard_gadget -name {drc_1} -row 2 -col 0
move_dashboard_gadget -name {timing_1} -row 0 -col 1
move_dashboard_gadget -name {utilization_2} -row 1 -col 1
move_dashboard_gadget -name {methodology_1} -row 2 -col 1

puts "STATUS: Project creation successful."

#################################################################################################################
# Generate BRAM IP
set ip_xci [get_files -quiet "*s2p_ram_128x1536.xci"]
if { [llength $ip_xci] != 1 } {
  catch {common::send_msg_id "UOV_TCL-007" "ERROR" "Expected exactly one s2p_ram_128x1536.xci, found: $ip_xci"}
  exit 1
}

set ip_user_files_dir "$proj_dir/${_xil_proj_name_}.ip_user_files"
set ipstatic_dir "$ip_user_files_dir/ipstatic"
set simlib_dir "$proj_dir/${_xil_proj_name_}.cache/compile_simlib"

generate_target all $ip_xci
export_ip_user_files -of_objects $ip_xci -no_script -sync -force -quiet
export_simulation -of_objects $ip_xci -directory "$ip_user_files_dir/sim_scripts" \
  -ip_user_files_dir $ip_user_files_dir -ipstatic_source_dir $ipstatic_dir \
  -lib_map_path [list "modelsim=$simlib_dir/modelsim" "questa=$simlib_dir/questa" \
                      "xcelium=$simlib_dir/xcelium" "vcs=$simlib_dir/vcs" \
                      "riviera=$simlib_dir/riviera"] \
  -use_ip_compiled_libs -force -quiet

if {[string equal [get_filesets -quiet s2p_ram_128x1536] ""]} {
  create_fileset -blockset s2p_ram_128x1536
}
set_property top s2p_ram_128x1536 [get_filesets s2p_ram_128x1536]
move_files -fileset [get_filesets s2p_ram_128x1536] $ip_xci

launch_run s2p_ram_128x1536_synth_1
wait_on_run s2p_ram_128x1536_synth_1
if { ![string equal [get_property PROGRESS [get_runs s2p_ram_128x1536_synth_1]] "100%"] } {
  catch {common::send_msg_id "UOV_TCL-008" "ERROR" "Out-of-context synthesis of s2p_ram_128x1536 failed."}
  exit 1
}
puts "STATUS: BRAM IP generation successful."

#################################################################################################################
# Launch behavioural simulation
launch_simulation
run all
set sim_errors [get_value -radix unsigned /uov_wrapper_tb/errors]
if { $sim_errors != 0 } {
  catch {common::send_msg_id "UOV_TCL-009" "ERROR" "Behavioural simulation failed: $sim_errors check(s) FAILED."}
  exit 1
}
close_sim
puts "STATUS: Behavioural simulation passed."

#################################################################################################################
# Launch synthesis, implementation, and bitstream generation
set nr_jobs 8
set bit_dir "[file normalize "$origin_dir/../results"]"
set bit_target "$bit_dir/uov_cw.bit"

launch_runs synth_1 -jobs $nr_jobs
wait_on_run synth_1
if { ![string equal [get_property PROGRESS [get_runs synth_1]] "100%"] } {
  catch {common::send_msg_id "UOV_TCL-010" "ERROR" "Synthesis failed, see [get_property DIRECTORY [get_runs synth_1]]/runme.log"}
  exit 1
}
puts "STATUS: Synthesis successful."

launch_runs impl_1 -to_step write_bitstream -jobs $nr_jobs
wait_on_run impl_1
if { ![string equal [get_property PROGRESS [get_runs impl_1]] "100%"] } {
  catch {common::send_msg_id "UOV_TCL-011" "ERROR" "Implementation failed, see [get_property DIRECTORY [get_runs impl_1]]/runme.log"}
  exit 1
}
puts "STATUS: Implementation and bitstream generation successful."

set bit_src [glob -nocomplain -directory [get_property DIRECTORY [get_runs impl_1]] -- *.bit]
if { [llength $bit_src] != 1 } {
  catch {common::send_msg_id "UOV_TCL-012" "ERROR" "Expected exactly one bitstream in the impl_1 run directory, found: $bit_src"}
  exit 1
}
file mkdir $bit_dir
file copy -force [lindex $bit_src 0] $bit_target
puts "STATUS: Bitstream written to $bit_target"

#################################################################################################################
# Open implementation run and export reports to results
set rep_dir "[file normalize "$origin_dir/../results"]"
file mkdir $rep_dir
open_run impl_1
set uov_cell [get_cells -quiet uov_wrapper_inst]
if { [llength $uov_cell] != 1 } {
  catch {common::send_msg_id "UOV_TCL-013" "ERROR" "Cannot find instance uov_wrapper_inst in the implemented design."}
  exit 1
}
report_utilization    -cells $uov_cell -file "$rep_dir/utilization.rpt"
report_timing_summary -file "$rep_dir/timing.rpt"
puts "STATUS: Reports written to $rep_dir"

exit 0
