# Collect the design sources
proc uov_glob_files { dir patterns } {
  set result [list]
  foreach pattern $patterns {
    foreach f [lsort [glob -nocomplain -directory $dir -- $pattern]] {
      lappend result [file normalize $f]
    }
  }
  return $result
}

